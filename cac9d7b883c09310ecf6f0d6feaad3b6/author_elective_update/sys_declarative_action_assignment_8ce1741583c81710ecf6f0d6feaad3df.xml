        <scripted_client_condition/>
        <server_script><![CDATA[
var city = (current.getValue('location') || '').trim();

if (!city) {
    gs.addErrorMessage('Please enter a city name first.');
} else {
    var recordId = current.getUniqueValue();

    // Save a new record first, if needed.
    if (current.isNewRecord()) {
        recordId = current.insert();
    }

    if (!recordId) {
        gs.addErrorMessage('Unable to save the Weather Data record.');
    } else {
        var result = new WeatherService().getWeather(
            city,
            String(recordId)
        );

        if (result.success) {
            gs.addInfoMessage(result.message);
        } else {
            gs.addErrorMessage(result.message);
        }
    }
}
]]></server_script>
